# ==============================================================================
# Archivo de configuración local para Kerbal Program Space
# ==============================================================================
# Instrucciones:
# 1. Copiá este archivo y renombralo como 'config.properties' en esta misma carpeta raíz.
# 2. Reemplazá 'TU_API_KEY_AQUI' por tu clave personal de N2YO.
# 3. Podés obtener una clave gratuita registrándote en: https://www.n2yo.com/api/
#
# Nota de seguridad:
# 'config.properties' está ignorado en .gitignore para evitar que se suba a GitHub.
# También podés configurar la variable de entorno N2YO_API_KEY en tu sistema operativo.
# ==============================================================================

n2yo.api.key=TU_API_KEY_AQUI
